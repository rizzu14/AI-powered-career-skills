# SkillPilot AI — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed to version control.

# Optional: LLM API integration for enriched recommendations
# If not set, the app runs in full offline mode.
SKILLPILOT_LLM_API_KEY=your_api_key_here
SKILLPILOT_LLM_ENDPOINT=https://api.example.com/v1
